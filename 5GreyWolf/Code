# Example Usage
# ==========================================
if __name__ == "__main__":
    np.random.seed(42)

    # 8 Test Cases covering 6 Requirements/Faults
    # Rows = Test Cases (TC0 to TC7), Cols = Requirements (R0 to R5)
    coverage_matrix = [
        [1, 1, 0, 0, 0, 0],  # TC0 (Time: 5s)
        [0, 1, 1, 0, 0, 0],  # TC1 (Time: 4s)
        [1, 0, 1, 1, 0, 0],  # TC2 (Time: 8s)
        [0, 0, 0, 1, 1, 0],  # TC3 (Time: 3s)
        [0, 0, 0, 0, 1, 1],  # TC4 (Time: 6s)
        [1, 1, 1, 0, 0, 0],  # TC5 (Time: 7s)
        [0, 0, 1, 1, 1, 0],  # TC6 (Time: 5s)
        [0, 0, 0, 0, 0, 1],  # TC7 (Time: 2s)
    ]

    # Execution time in seconds for each test case
    execution_times = [5, 4, 8, 3, 6, 7, 5, 2]

    # Run Binary GWO (Prioritizing 80% coverage, 20% time reduction)
    optimizer = BinaryGreyWolfOptimizer(
        coverage_matrix=coverage_matrix,
        execution_times=execution_times,
        n_wolves=15,
        max_iter=50,
        w_cov=0.8,
        w_time=0.2
    )

    best_suite, best_fitness = optimizer.optimize()
    selected_tcs = np.where(best_suite == 1)[0]

    # Calculate final metrics
    final_coverage = np.sum(np.any(np.array(coverage_matrix)[selected_tcs] == 1, axis=0)) / len(coverage_matrix[0]) * 100
    final_time = np.sum(np.array(execution_times)[selected_tcs])

    print(f"Optimal Binary Vector : {best_suite.astype(int)}")
    print(f"Selected Test Cases   : {[f'TC{i}' for i in selected_tcs]}")
    print(f"Requirement Coverage  : {final_coverage:.1f}%")
    print(f"Execution Time        : {final_time}s (down from {sum(execution_times)}s)")
    print(f"Best Fitness Score    : {best_fitness:.4f}")
