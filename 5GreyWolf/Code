import numpy as np

class BinaryGreyWolfOptimizer:
    def __init__(self, coverage_matrix, execution_times, n_wolves=20, max_iter=100, w_cov=0.7, w_time=0.3):
        """
        :param coverage_matrix: 2D binary numpy array (rows = test cases, cols = requirements/faults)
        :param execution_times: 1D numpy array of execution time for each test case
        :param n_wolves: Population size (number of search agents)
        :param max_iter: Maximum number of iterations
        :param w_cov: Weight for fault/requirement coverage (0 to 1)
        :param w_time: Weight for execution time reduction (0 to 1)
        """
        self.coverage_matrix = np.array(coverage_matrix)
        self.execution_times = np.array(execution_times)
        self.num_tests, self.num_reqs = self.coverage_matrix.shape
        
        self.n_wolves = n_wolves
        self.max_iter = max_iter
        self.w_cov = w_cov
        self.w_time = w_time
        self.total_time = np.sum(self.execution_times)

    def fitness(self, position):
        """
        Evaluates a candidate test suite (binary vector).
        Higher score = better test suite (high coverage, low execution time).
        """
        selected_indices = np.where(position == 1)[0]
        
        # Penalize empty test suites
        if len(selected_indices) == 0:
            return 0.0

        # 1. Calculate Requirement/Fault Coverage Ratio
        covered_reqs = np.any(self.coverage_matrix[selected_indices] == 1, axis=0)
        coverage_ratio = np.sum(covered_reqs) / self.num_reqs

        # 2. Calculate Execution Time Saved Ratio
        suite_time = np.sum(self.execution_times[selected_indices])
        time_saved_ratio = 1.0 - (suite_time / self.total_time)

        # Multi-objective fitness score
        return (self.w_cov * coverage_ratio) + (self.w_time * time_saved_ratio)

    def sigmoid(self, x):
        """Maps continuous values to [0, 1] probability space."""
        return 1 / (1 + np.exp(-10 * (x - 0.5)))

    def optimize(self):
        # Initialize binary population randomly
        positions = np.random.randint(2, size=(self.n_wolves, self.num_tests))

        # Initialize Alpha, Beta, and Delta wolves (top 3 solutions)
        alpha_pos = np.zeros(self.num_tests)
        alpha_score = -float("inf")

        beta_pos = np.zeros(self.num_tests)
        beta_score = -float("inf")

        delta_pos = np.zeros(self.num_tests)
        delta_score = -float("inf")

        # Main optimization loop
        for iter_num in range(self.max_iter):
            # Evaluate fitness for each wolf
            for i in range(self.n_wolves):
                score = self.fitness(positions[i])

                if score > alpha_score:
                    delta_score, delta_pos = beta_score, beta_pos.copy()
                    beta_score, beta_pos = alpha_score, alpha_pos.copy()
                    alpha_score, alpha_pos = score, positions[i].copy()
                elif score > beta_score:
                    delta_score, delta_pos = beta_score, beta_pos.copy()
                    beta_score, beta_pos = score, positions[i].copy()
                elif score > delta_score:
                    delta_score, delta_pos = score, positions[i].copy()

            # Parameter 'a' decreases linearly from 2 to 0 (exploration -> exploitation)
            a = 2 - iter_num * (2 / self.max_iter)

            # Update position of each wolf
            for i in range(self.n_wolves):
                for j in range(self.num_tests):
                    # Alpha guidance
                    r1, r2 = np.random.rand(), np.random.rand()
                    A1 = 2 * a * r1 - a
                    C1 = 2 * r2
                    D_alpha = abs(C1 * alpha_pos[j] - positions[i, j])
                    X1 = alpha_pos[j] - A1 * D_alpha

                    # Beta guidance
                    r1, r2 = np.random.rand(), np.random.rand()
                    A2 = 2 * a * r1 - a
                    C2 = 2 * r2
                    D_beta = abs(C2 * beta_pos[j] - positions[i, j])
                    X2 = beta_pos[j] - A2 * D_beta

                    # Delta guidance
                    r1, r2 = np.random.rand(), np.random.rand()
                    A3 = 2 * a * r1 - a
                    C3 = 2 * r2
                    D_delta = abs(C3 * delta_pos[j] - positions[i, j])
                    X3 = delta_pos[j] - A3 * D_delta

                    # Continuous average position
                    X_continuous = (X1 + X2 + X3) / 3.0

                    # Binarize using Sigmoid transfer function
                    if np.random.rand() < self.sigmoid(X_continuous):
                        positions[i, j] = 1
                    else:
                        positions[i, j] = 0

        return alpha_pos, alpha_score


