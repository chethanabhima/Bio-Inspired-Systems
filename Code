import numpy as np
from scipy.special import gamma


class CuckooPathPlanner:
    def __init__(
        self,
        start,
        goal,
        obstacles,
        bounds,
        num_waypoints=5,
        n_nests=30,
        pa=0.25,
        max_iter=200,
    ):
        """
        start: tuple (x, y)
        goal: tuple (x, y)
        obstacles: list of tuples [(ox, oy, radius), ...]
        bounds: tuple (min_coord, max_coord)
        """
        self.start = np.array(start, dtype=float)
        self.goal = np.array(goal, dtype=float)
        self.obstacles = obstacles
        self.min_bound, self.max_bound = bounds
        self.num_waypoints = num_waypoints
        self.dim = num_waypoints * 2  # Each waypoint has (x, y)
        self.n_nests = n_nests
        self.pa = pa  # Discovery probability
        self.max_iter = max_iter

    def _build_full_path(self, nest):
        """Reshapes a 1D nest vector into 2D waypoints bounded by start and goal."""
        waypoints = nest.reshape((self.num_waypoints, 2))
        return np.vstack([self.start, waypoints, self.goal])

    def _segment_circle_collision(self, p1, p2, center, radius):
        """Calculates collision violation depth between line segment p1-p2 and a circle."""
        d = p2 - p1
        f = p1 - center
        a = np.dot(d, d)
        if a == 0:
            dist = np.linalg.norm(f)
            return max(0.0, radius - dist)

        # Project circle center onto the line segment
        t = np.clip(-np.dot(f, d) / a, 0.0, 1.0)
        closest = p1 + t * d
        dist = np.linalg.norm(closest - center)

        # Add a small safety margin (0.2) around obstacles
        safe_radius = radius + 0.2
        return max(0.0, safe_radius - dist)

    def fitness(self, nest):
        """Objective function: Path Length + Heavy Collision Penalty."""
        path = self._build_full_path(nest)
        total_length = 0.0
        collision_penalty = 0.0

        for i in range(len(path) - 1):
            p1, p2 = path[i], path[i + 1]
            total_length += np.linalg.norm(p2 - p1)

            for ox, oy, r in self.obstacles:
                violation = self._segment_circle_collision(
                    p1, p2, np.array([ox, oy]), r
                )
                if violation > 0:
                    collision_penalty += 1000.0 * (1.0 + violation)

        return total_length + collision_penalty

    def _levy_flight(self, beta=1.5):
        """Generates a step vector using Mantegna's algorithm for Lévy distribution."""
        sigma_u = (
            gamma(1 + beta)
            * np.sin(np.pi * beta / 2)
            / (gamma((1 + beta) / 2) * beta * (2 ** ((beta - 1) / 2)))
        ) ** (1 / beta)

        u = np.random.normal(0, sigma_u, size=self.dim)
        v = np.random.normal(0, 1, size=self.dim)
        step = u / (np.abs(v) ** (1 / beta))
        return step

    def optimize(self):
        # 1. Initialize random nests (candidate waypoint sets)
        nests = np.random.uniform(
            self.min_bound, self.max_bound, (self.n_nests, self.dim)
        )
        fitness_vals = np.array([self.fitness(n) for n in nests])

        best_idx = np.argmin(fitness_vals)
        best_nest = nests[best_idx].copy()
        best_fitness = fitness_vals[best_idx]

        # 2. Main Optimization Loop
        for _ in range(self.max_iter):
            # --- Phase A: Global Search via Lévy Flights ---
            for i in range(self.n_nests):
                step_size = 0.1 * self._levy_flight() * (nests[i] - best_nest)
                new_nest = nests[i] + step_size * np.random.randn(self.dim)
                new_nest = np.clip(new_nest, self.min_bound, self.max_bound)

                new_fit = self.fitness(new_nest)
                # Compare against a randomly chosen host nest
                j = np.random.randint(0, self.n_nests)
                if new_fit < fitness_vals[j]:
                    nests[j] = new_nest
                    fitness_vals[j] = new_fit

            # --- Phase B: Local Search / Abandon Worst Nests (Probability pa) ---
            abandon_mask = np.random.rand(self.n_nests, self.dim) < self.pa
            perm1 = np.random.permutation(self.n_nests)
            perm2 = np.random.permutation(self.n_nests)

            steps = np.random.rand() * (nests[perm1] - nests[perm2])
            new_nests = nests + steps * abandon_mask
            new_nests = np.clip(new_nests, self.min_bound, self.max_bound)

            for i in range(self.n_nests):
                new_fit = self.fitness(new_nests[i])
                if new_fit < fitness_vals[i]:
                    nests[i] = new_nests[i]
                    fitness_vals[i] = new_fit

            # Update global best
            current_best_idx = np.argmin(fitness_vals)
            if fitness_vals[current_best_idx] < best_fitness:
                best_fitness = fitness_vals[current_best_idx]
                best_nest = nests[current_best_idx].copy()

        return self._build_full_path(best_nest), best_fitness


# --- Example Execution & Alphanumeric Output ---
if __name__ == "__main__":
    np.random.seed(42)

    start_pos = (0.0, 0.0)
    goal_pos = (10.0, 10.0)
    # Obstacles defined as (center_x, center_y, radius)
    obstacle_list = [
        (2.5, 2.5, 1.2),
        (5.0, 5.5, 1.5),
        (7.5, 3.0, 1.0),
        (7.0, 8.0, 1.2),
        (3.0, 7.0, 1.1),
    ]

    planner = CuckooPathPlanner(
        start=start_pos,
        goal=goal_pos,
        obstacles=obstacle_list,
        bounds=(0.0, 10.0),
        num_waypoints=4,
        n_nests=40,
        pa=0.25,
        max_iter=300,
    )

    optimal_path, final_cost = planner.optimize()

    print("=== OPTIMAL PATH SOLUTION ===")
    print(f"Total Path Cost (Distance): {final_cost:.4f}")
    print(f"Collision-Free            : {'YES' if final_cost < 1000.0 else 'NO'}")
    print("\nWaypoints Sequence:")
    for idx, (x, y) in enumerate(optimal_path):
        tag = "START" if idx == 0 else ("GOAL " if idx == len(optimal_path) - 1 else f"WP-{idx:02d}")
        print(f"  {tag}: (X={x:7.4f}, Y={y:7.4f})")
